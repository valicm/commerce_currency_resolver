<?php

/**
 * @file
 * Main module file.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_entity_view_alter().
 */
function commerce_currency_resolver_pricelist_entity_view_alter(array &$build, EntityInterface $entity, $view_mode): void {
  // Prices from price lists differ per currency.
  if (isset($build['#commerce_product']) || isset($build['#commerce_product_variation'])) {
    $build['#cache']['contexts'][] = 'currency_resolver';
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for 'commerce_currency_resolver_settings'.
 */
function commerce_currency_resolver_pricelist_form_commerce_currency_resolver_settings_alter(array &$form, FormStateInterface $form_state): void {
  $form['pricelist_lists_win'] = [
    '#type' => 'checkbox',
    '#title' => t('Price lists win over currency fields'),
    '#description' => t('A price list item in the current currency is used before the price field for that currency. Without it, the price field wins and price lists apply only where a product has no price field for the currency.'),
    '#default_value' => Drupal::config('commerce_currency_resolver_pricelist.settings')->get('lists_win') ?? TRUE,
    '#weight' => 5,
  ];
  // The exchanger submodule gives the button its own handlers, which replace
  // the form's; otherwise the form's handlers run.
  if (isset($form['submit']['#submit'])) {
    $form['submit']['#submit'][] = 'commerce_currency_resolver_pricelist_form_submit';
  }
  else {
    $form['#submit'][] = 'commerce_currency_resolver_pricelist_form_submit';
  }
}

/**
 * Submission handler for commerce_currency_resolver_pricelist_form_commerce_currency_resolver_settings_alter().
 */
function commerce_currency_resolver_pricelist_form_submit($form, FormStateInterface $form_state): void {
  Drupal::configFactory()->getEditable('commerce_currency_resolver_pricelist.settings')
    ->set('lists_win', (bool) $form_state->getValue('pricelist_lists_win'))
    ->save();
}
