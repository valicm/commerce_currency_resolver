<?php

/**
 * @file
 * Install file for commerce_currency_resolver.
 */

/**
 * Upgrade 1.x to 2.x version of the module.
 */
function commerce_currency_resolver_update_10001(): void {
  $config_factory = Drupal::configFactory();
  $configuration = $config_factory->get('commerce_currency_resolver.settings');
  $currency_mapping = $configuration->get('currency_mapping');
  $mapping = $config_factory->get('commerce_currency_resolver.currency_mapping')->getRawData();
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');

  // It was required in version 1.x, so we need to install it.
  $module_installer->install([
    'commerce_currency_resolver_exchanger',
  ]);

  switch ($currency_mapping) {
    case  'cookie':
      $module_installer->install([
        'commerce_currency_resolver_cookie',
      ]);
      break;

    case 'geo':
      $module_installer->install([
        'commerce_currency_resolver_geoip',
      ]);
      $config_factory->getEditable('commerce_currency_resolver_geoip.currency_mapping')->set('matrix', $mapping['matrix'] ?? [])
        ->set('logic', $mapping['logic'])
        ->save();
      break;

    case 'lang':
      $module_installer->install([
        'commerce_currency_resolver_language',
      ]);
      $config_factory->getEditable('commerce_currency_resolver_language.currency_mapping')->set('matrix', $mapping['matrix'] ?? [])->save();
      break;
  }


}
